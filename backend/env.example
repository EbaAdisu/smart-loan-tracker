# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# 1. Create a free account
# 2. Create a cluster (M0 FREE tier)
# 3. Create a database user
# 4. Get connection string and replace below
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/loan-tracker?retryWrites=true&w=majority

# Better Auth Configuration
# Generate a secure secret with: openssl rand -base64 32
# Or use any random 32+ character string
BETTER_AUTH_SECRET=change-this-to-a-random-32-character-string-or-longer
BETTER_AUTH_URL=http://localhost:3000

# Expo Push Notifications (Optional - can add later)
# Get from: https://expo.dev/
EXPO_ACCESS_TOKEN=

# CORS Configuration (for Expo development)
# Add your mobile dev server URL
CORS_ORIGIN=http://localhost:8081,exp://localhost:8081

